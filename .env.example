# Copia este archivo a .env.local y completa los valores.
# .env.local NO se sube a Git (está en .gitignore).
#
# Valores locales: los muestra `npx supabase start` al terminar
# ("API URL" y "anon key").

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# NUNCA pongas aquí, ni en ninguna variable VITE_:
#   - la clave service_role
#   - el archivo .p12 o su contraseña
# Esos valores van solo en los secretos del servidor (Fase 4).
